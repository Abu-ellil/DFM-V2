# Neon Database Configuration
# Get these from https://neonconsole.com
NEON_PROJECT_ID=your-project-id-here
NEON_DB_PASSWORD=your-database-password-here
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require

# Factory-specific databases (optional - for per-factory data isolation)
# Format: NEON_DB_{MACHINE_ID}=database-connection-string
# Examples:
# NEON_DB_E809C7B617ABD1A4=postgres://user:pass@host/dfm-E809C7B617ABD1A4?sslmode=require
# NEON_DB_A123B456C789D012=postgres://user:pass@host/dfm-A123B456C789D012?sslmode=require

# License Configuration (must match your desktop app's license.js)
LICENSE_SECRET=DateFactory2024SecretKey#$%^&*()!@#

# Optional: Custom API base URL (defaults to Vercel deployment)
# API_BASE_URL=https://your-project.vercel.app
